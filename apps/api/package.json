{
  "name": "@aproba-flow/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "bun prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@aproba-flow/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@sinclair/typebox": "^0.34.41",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "elysia": "^1.4.12",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "prisma": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
